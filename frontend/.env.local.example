# Copy to frontend/.env.local. Committed file: placeholders only, never real keys.
#
# Every NEXT_PUBLIC_* value is compiled into the browser bundle at build time, so
# changing one on Vercel needs a redeploy, not a restart. In production these are
# set in the Vercel project, not here - see docs/DEPLOYMENT.md step 4.

# No trailing slash. Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Accounts (Phase 2). Supabase Dashboard > Project Settings > API.
# The anon (publishable) key is safe to expose; it only works with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://qzngtrpdqtvgrbaxtzar.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key for the sign-up CAPTCHA (pair with DM_TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
