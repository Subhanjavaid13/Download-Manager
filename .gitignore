# =============================================================================
# Downloader Manager - root .gitignore
# Covers backend/ (FastAPI + uv), frontend/ (Next.js), and docs/.
# frontend/.gitignore (generated by create-next-app) still applies on top.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment (never commit real values; keep *.example files)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
cookies.txt
*.cookies

# -----------------------------------------------------------------------------
# Backend (Python / FastAPI / uv / yt-dlp)
# -----------------------------------------------------------------------------
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/**/*$py.class
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/coverage.xml
backend/.python-version
backend/*.egg-info/
backend/build/
backend/dist/

# Runtime data: downloaded media, job output, local database
backend/downloads/
backend/data/
backend/tmp/
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
backend/*.sqlite
backend/*.sqlite3
backend/*.part
backend/*.ytdl
backend/*.log
backend/logs/

# -----------------------------------------------------------------------------
# Frontend (Next.js / Node)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/coverage/
frontend/.vercel/
frontend/.turbo/
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# -----------------------------------------------------------------------------
# Docs (keep docs/PRD.md and other shared docs; ignore private/local notes)
# -----------------------------------------------------------------------------
docs/private/
docs/drafts/
docs/notes/
docs/**/*.local.md
docs/**/*.private.md
docs/**/*.draft.md
docs/**/*.docx
docs/**/*.xlsx
docs/**/*.pptx
docs/**/~$*

# -----------------------------------------------------------------------------
# Media / large binaries (safety net; downloads live in backend/downloads)
# -----------------------------------------------------------------------------
*.mp3
*.mp4
*.m4a
*.webm
*.mkv
*.wav
*.flac
*.opus
*.aac

# -----------------------------------------------------------------------------
# Editors, OS, tooling
# -----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.claude/
*.local.json
node_modules/
