# Copy to backend/.env and fill in what you need. Every key is optional in development.
#
# This file is committed, so it must never hold a real value. Empty or an obvious
# placeholder only - CI fails the build if a secret-shaped key here has a value.
#
# In production none of this file is used: Render supplies the environment from
# render.yaml at the repo root. docs/DEPLOYMENT.md maps every key to where its
# value comes from.

DM_ENVIRONMENT=development
DM_LOG_LEVEL=info

# JSON list, not a comma-separated string. Exactly the browser origins allowed to
# call this API: scheme included, no trailing slash.
# Production is ["https://app.yourdomain.com"]. Never ["*"] - the API sends
# credentials, so a wildcard would let any site read a signed-in user's history.
DM_CORS_ORIGINS=["http://localhost:3000"]

# Not a DM_ setting: uvicorn reads FORWARDED_ALLOW_IPS itself, and only trusts
# X-Forwarded-For from the addresses listed there (its default is 127.0.0.1).
# Leave it unset locally. Render sets it to "*", because behind a load balancer
# every request otherwise looks like it came from the balancer and the per-IP
# rate limit turns into one global limit.

# Where finished files are written. Files are deleted after DM_JOB_TTL_MINUTES.
DM_DOWNLOAD_DIR=./downloads
DM_JOB_TTL_MINUTES=60
DM_WORKER_CONCURRENCY=2

# Abuse / cost controls
DM_MAX_DURATION_SEC=10800
DM_MAX_FILE_MB=500
DM_RATE_LIMIT_INFO=30/minute
DM_RATE_LIMIT_JOBS=10/minute

# Leave empty to auto-detect ffmpeg on PATH (or the winget install folder on Windows).
DM_FFMPEG_LOCATION=

# --- Phase 1: file storage ---
# local: files stay in DM_DOWNLOAD_DIR and the API streams them (default, fine for dev).
# r2:    files go to Cloudflare R2 and users get a signed link (zero egress in production).
DM_STORAGE=local
# R2 settings (only when DM_STORAGE=r2). Create an API token scoped to one bucket.
# Give the bucket a lifecycle rule that deletes objects after a day, as a backstop
# for the files the app's own TTL misses. See docs/DEPLOYMENT.md step 2.
DM_R2_ACCOUNT_ID=
DM_R2_ACCESS_KEY_ID=
DM_R2_SECRET_ACCESS_KEY=
DM_R2_BUCKET=
# Optional; defaults to https://<account_id>.r2.cloudflarestorage.com
DM_R2_ENDPOINT_URL=

# --- Phase 2: Supabase Auth ---
# Set DM_SUPABASE_URL to verify tokens with the project's JWKS (recommended).
# Only set DM_SUPABASE_JWT_SECRET for older projects still on the HS256 shared secret.
DM_REQUIRE_AUTH=false
DM_SUPABASE_URL=
# Public anon/publishable key (Dashboard > Project Settings > API). Needed for sign-up only.
DM_SUPABASE_ANON_KEY=
# Only for older projects still on the HS256 shared secret; new projects use JWKS automatically.
DM_SUPABASE_JWT_SECRET=

# --- Phase 2: quotas and sign-up hardening ---
DM_ANON_DAILY_LIMIT=3            # guest downloads per browser per day while auth is on
DM_CHECK_DISPOSABLE_EMAIL=true   # refuse throwaway domains at sign-up
DM_CHECK_MX=true                 # refuse domains that cannot receive mail
DM_TURNSTILE_SECRET=             # Cloudflare Turnstile secret; leave empty to skip the CAPTCHA
DM_IP_HASH_SALT=change-me        # IPs are stored only as salted hashes in the events table

# --- Phase 2: Database ---
# SQLite locally; in production use the Supabase "Transaction pooler" URI (port 6543).
# The weekly pg_dump backup uses the *session* pooler (port 5432) instead: the
# transaction pooler has no session state and pg_dump's COPY protocol fails on it.
DM_DATABASE_URL=sqlite:///./dm.db
